[gd_scene format=3]

[ext_resource type="Script" path="res://scripts/level_menu_layer.gd" id="1_menu"]
[ext_resource type="Theme" path="res://resources/ui/menu_theme.tres" id="2_theme"]
[ext_resource type="PackedScene" path="res://scenes/audio/audio_settings_control.tscn" id="3_volume"]
[ext_resource type="PackedScene" path="res://scenes/ui/display_settings_control.tscn" id="4_display"]

[node name="LevelMenu" type="CanvasLayer"]
layer = 40
process_mode = 3
script = ExtResource("1_menu")

[node name="Overlay" type="ColorRect" parent="."]
visible = false
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
color = Color(0.02, 0.045, 0.033, 0.86)
theme = ExtResource("2_theme")

[node name="Center" type="CenterContainer" parent="Overlay"]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
mouse_filter = 2

[node name="Panel" type="PanelContainer" parent="Overlay/Center"]
custom_minimum_size = Vector2(500, 0)
layout_mode = 2

[node name="Scroll" type="ScrollContainer" parent="Overlay/Center/Panel"]
layout_mode = 2
horizontal_scroll_mode = 0
follow_focus = true

[node name="Buttons" type="VBoxContainer" parent="Overlay/Center/Panel/Scroll"]
layout_mode = 2
size_flags_horizontal = 3
theme_override_constants/separation = 12

[node name="Title" type="Label" parent="Overlay/Center/Panel/Scroll/Buttons"]
layout_mode = 2
theme_override_font_sizes/font_size = 30
text = "游戏暂停"
horizontal_alignment = 1

[node name="Hint" type="Label" parent="Overlay/Center/Panel/Scroll/Buttons"]
custom_minimum_size = Vector2(340, 48)
layout_mode = 2
theme_override_font_sizes/font_size = 14
text = "返回主菜单或退出后，保留主线关卡进度。\n当前布局与战斗进度不会保留。"
horizontal_alignment = 1

[node name="ResumeButton" type="Button" parent="Overlay/Center/Panel/Scroll/Buttons"]
layout_mode = 2
text = "继续游戏"

[node name="RestartButton" type="Button" parent="Overlay/Center/Panel/Scroll/Buttons"]
layout_mode = 2
text = "重新开始"

[node name="TitleButton" type="Button" parent="Overlay/Center/Panel/Scroll/Buttons"]
layout_mode = 2
text = "返回主菜单"

[node name="QuitButton" type="Button" parent="Overlay/Center/Panel/Scroll/Buttons"]
layout_mode = 2
text = "退出游戏"

[node name="KeyboardHint" type="Label" parent="Overlay/Center/Panel/Scroll/Buttons"]
layout_mode = 2
theme_override_font_sizes/font_size = 13
text = "Esc 返回游戏"
horizontal_alignment = 1

[node name="AudioVolume" parent="Overlay/Center/Panel/Scroll/Buttons" instance=ExtResource("3_volume")]
